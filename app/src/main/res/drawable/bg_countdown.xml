<?xml version="1.0" encoding="utf-8"?>
<!-- the old film countdown leader: a dark disc, a gold ring and cross hairs -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="#EB0A0A0A" /><stroke android:width="2dp" android:color="#E8B44A" /></shape></item>
    <item android:bottom="7dp" android:left="7dp" android:right="7dp" android:top="7dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#66E8B44A" /></shape></item>
    <item android:gravity="center_vertical" android:height="1dp"><shape android:shape="rectangle"><solid android:color="#40E8B44A" /></shape></item>
    <item android:gravity="center_horizontal" android:width="1dp"><shape android:shape="rectangle"><solid android:color="#40E8B44A" /></shape></item>
</layer-list>
