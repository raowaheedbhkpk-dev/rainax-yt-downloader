<?xml version="1.0" encoding="utf-8"?>
<!-- a chapter as a film frame: the film colour (dark or light) with sprocket holes along the top and bottom -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="@color/film_bg" /></shape></item>
    <item android:gravity="top" android:height="6dp" android:top="3dp" android:left="4dp" android:right="4dp">
        <shape android:shape="line"><stroke android:width="4dp" android:color="?attr/rxBg" android:dashGap="6dp" android:dashWidth="6dp" /></shape></item>
    <item android:gravity="bottom" android:height="6dp" android:bottom="3dp" android:left="4dp" android:right="4dp">
        <shape android:shape="line"><stroke android:width="4dp" android:color="?attr/rxBg" android:dashGap="6dp" android:dashWidth="6dp" /></shape></item>
</layer-list>
