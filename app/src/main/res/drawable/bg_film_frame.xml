<?xml version="1.0" encoding="utf-8"?>
<!-- one chapter as a film frame: a dark frame with a row of sprocket holes along the top and bottom -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#141414" /></shape></item>
    <item android:gravity="top" android:height="6dp" android:top="3dp" android:left="4dp" android:right="4dp">
        <shape android:shape="line"><stroke android:width="4dp" android:color="#40FFFFFF" android:dashGap="6dp" android:dashWidth="6dp" /></shape></item>
    <item android:gravity="bottom" android:height="6dp" android:bottom="3dp" android:left="4dp" android:right="4dp">
        <shape android:shape="line"><stroke android:width="4dp" android:color="#40FFFFFF" android:dashGap="6dp" android:dashWidth="6dp" /></shape></item>
</layer-list>
