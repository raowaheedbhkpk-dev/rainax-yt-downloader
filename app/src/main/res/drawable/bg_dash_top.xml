<?xml version="1.0" encoding="utf-8"?>
<!-- a dashed line along the top edge only (the tear line above the download numbers) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="-4dp" android:left="-4dp" android:right="-4dp" android:top="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/rx_divider_strong"
                android:dashGap="4dp"
                android:dashWidth="5dp" />
        </shape>
    </item>
</layer-list>
