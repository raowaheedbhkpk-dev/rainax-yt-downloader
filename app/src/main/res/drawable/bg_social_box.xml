<?xml version="1.0" encoding="utf-8"?>
<!-- Social link box (Cinema Pro): a flat card with a thin edge and a film-red line along the bottom -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rx_primary" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/rxCard" />
            <stroke android:width="1dp" android:color="@color/rx_outline" />
        </shape>
    </item>
</layer-list>
