<?xml version="1.0" encoding="utf-8"?>
<!-- record grooves over the cover (thin dark rings) and a soft shine -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="#26000000" /></shape></item>
    <item android:bottom="16dp" android:left="16dp" android:right="16dp" android:top="16dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#33000000" /></shape></item>
    <item android:bottom="34dp" android:left="34dp" android:right="34dp" android:top="34dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#2E000000" /></shape></item>
    <item android:bottom="52dp" android:left="52dp" android:right="52dp" android:top="52dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#29000000" /></shape></item>
    <item android:bottom="70dp" android:left="70dp" android:right="70dp" android:top="70dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#24000000" /></shape></item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="#00FFFFFF" android:centerColor="#1AFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
