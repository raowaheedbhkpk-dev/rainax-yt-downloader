<?xml version="1.0" encoding="utf-8"?>
<!-- the search box while typing: a red border and a soft red glow ring around it -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#1FD7263D" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape>
            <solid android:color="?attr/rxSurface" />
            <stroke android:width="2dp" android:color="?attr/rxAccent" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
