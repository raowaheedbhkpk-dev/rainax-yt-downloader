<?xml version="1.0" encoding="utf-8"?>
<!-- voice search: deep night background with a soft red glow rising from the bottom -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0A0F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="1.0"
                android:endColor="#000B0A0F"
                android:gradientRadius="520dp"
                android:startColor="#552A0612"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
