<?xml version="1.0" encoding="utf-8"?>
<!-- a quick-toggle tile in Settings, off: the page surface with a thin edge (on: filled with the accent in code) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/rxSurface" />
            <stroke android:width="1dp" android:color="?attr/rxOutline" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</ripple>
