<?xml version="1.0" encoding="utf-8"?>
<!-- Side menu (≡ on Home), like YouTube's: topics, then the app's places -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:id="@+id/exploreScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:contentDescription="Close menu"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/explorePanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="?attr/rxSurface"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/rx_display"
                android:text="RAINAX"
                android:textColor="@color/rx_text"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/rx_display_semibold"
                android:text="Tube"
                android:textColor="@color/rx_primary"
                android:textSize="21sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/exploreList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp" />
        </ScrollView>

        <TextView
            android:id="@+id/exploreVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/rx_text2"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
