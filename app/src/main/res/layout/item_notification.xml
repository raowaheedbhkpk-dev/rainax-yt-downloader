<?xml version="1.0" encoding="utf-8"?>
<!-- One notification: unread dot, channel picture, "For you" / title / time, video picture, ••• -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/rx_space_12"
    android:paddingStart="6dp">

    <View
        android:id="@+id/nDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_notif_dot" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/nAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/rx_space_8"
        android:background="@drawable/bg_avatar"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Round" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/rx_body"
            android:maxLines="2"
            android:textColor="@color/rx_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rx_space_2"
            android:ellipsize="end"
            android:fontFamily="@font/rx_body"
            android:maxLines="2"
            android:textColor="@color/rx_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/nTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/rx_body"
            android:textColor="@color/rx_text2"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/nThumb"
        android:layout_width="124dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_thumb"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Sharp" />

    <ImageButton
        android:id="@+id/nMore"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="More"
        android:src="@drawable/ic_more"
        app:tint="@color/rx_text" />
</LinearLayout>
