<?xml version="1.0" encoding="utf-8"?>
<!-- Home's sun button: System / Light / Dark, then Theme (the accent rings). Filled in by ThemePopup. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="288dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_theme_popup"
    android:elevation="12dp">

    <!-- page 1: the look -->
    <LinearLayout
        android:id="@+id/tpModes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/rx_space_8">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/rx_space_16"
            android:layout_marginTop="@dimen/rx_space_8"
            android:layout_marginBottom="@dimen/rx_space_4"
            android:letterSpacing="0.2"
            android:text="Appearance"
            android:textAllCaps="true"
            android:textColor="@color/rx_gold"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/tpSystem"
            style="@style/Widget.Rainax.ThemeRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_theme_system"
                app:tint="@color/rx_text" />

            <TextView
                style="@style/Widget.Rainax.ThemeRowText"
                android:text="System" />

            <ImageView
                android:id="@+id/tpSystemCheck"
                style="@style/Widget.Rainax.ThemeRowCheck" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tpLight"
            style="@style/Widget.Rainax.ThemeRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_brightness"
                app:tint="@color/rx_text" />

            <TextView
                style="@style/Widget.Rainax.ThemeRowText"
                android:text="Light" />

            <ImageView
                android:id="@+id/tpLightCheck"
                style="@style/Widget.Rainax.ThemeRowCheck" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tpDark"
            style="@style/Widget.Rainax.ThemeRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_moon"
                app:tint="@color/rx_text" />

            <TextView
                style="@style/Widget.Rainax.ThemeRowText"
                android:text="Dark" />

            <ImageView
                android:id="@+id/tpDarkCheck"
                style="@style/Widget.Rainax.ThemeRowCheck" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/rx_space_16"
            android:layout_marginVertical="@dimen/rx_space_4"
            android:background="@color/rx_divider" />

        <!-- Theme: opens the accent rings -->
        <LinearLayout
            android:id="@+id/tpTheme"
            style="@style/Widget.Rainax.ThemeRow">

            <View
                android:id="@+id/tpThemeDot"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_theme_dot" />

            <TextView
                style="@style/Widget.Rainax.ThemeRowText"
                android:text="Theme" />

            <TextView
                android:id="@+id/tpThemeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/rx_space_4"
                android:textColor="@color/rx_text2"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                app:tint="@color/rx_text2" />
        </LinearLayout>
    </LinearLayout>

    <!-- page 2: the accent rings -->
    <LinearLayout
        android:id="@+id/tpAccents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/rx_space_12"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/rx_space_4"
            android:paddingTop="@dimen/rx_space_4">

            <ImageButton
                android:id="@+id/tpBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/rx_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme"
                android:textColor="@color/rx_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tpGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/rx_space_8" />
    </LinearLayout>
</FrameLayout>
