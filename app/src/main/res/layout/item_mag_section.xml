<?xml version="1.0" encoding="utf-8"?>
<!-- Magazine Home: a section opener. Gold chapter number, big Oswald heading, a rule, and MORE -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/rx_space_16"
    android:paddingTop="26dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/magLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.25"
        android:textColor="@color/rx_gold"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/magTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rx_display"
            android:includeFontPadding="false"
            android:textAllCaps="true"
            android:textColor="@color/rx_text"
            android:textSize="24sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/rx_space_12"
            android:layout_weight="1"
            android:background="@color/rx_divider" />

        <TextView
            android:id="@+id/magMore"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:paddingHorizontal="@dimen/rx_space_4"
            android:text="More"
            android:textAllCaps="true"
            android:textColor="@color/rx_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
