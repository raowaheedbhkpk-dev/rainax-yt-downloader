<?xml version="1.0" encoding="utf-8"?>
<!-- Search: one recent search as a ticket stub; tap searches, hold for Search / Edit / Remove -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginHorizontal="@dimen/rx_space_4"
    android:background="@drawable/bg_recent_stub"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxWidth="180dp"
    android:maxLines="1"
    android:paddingHorizontal="14dp"
    android:textColor="@color/rx_text"
    android:textSize="14sp" />
