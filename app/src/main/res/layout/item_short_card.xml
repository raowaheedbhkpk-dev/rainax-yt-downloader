<?xml version="1.0" encoding="utf-8"?>
<!-- A Short in the Home strip: tall picture with the title on it -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scBox"
    android:layout_width="128dp"
    android:layout_height="228dp"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/bg_thumb_big">

    <ImageView
        android:id="@+id/scThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_short_scrim" />

    <TextView
        android:id="@+id/scTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:ellipsize="end"
        android:maxLines="3"
        android:padding="8dp"
        android:shadowColor="#99000000"
        android:shadowRadius="4"
        android:textColor="@color/rx_white"
        android:textSize="12.5sp"
        android:textStyle="bold" />
</FrameLayout>
