<?xml version="1.0" encoding="utf-8"?>
<!-- Magazine Home loading: a section opener (gold chapter number, big heading, rule) -->
<com.rainax.ytdownloader.RxShimmer xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/rx_space_16"
    android:paddingTop="26dp"
    android:paddingBottom="10dp">

    <View
        android:layout_width="80dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_skeleton_gold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="190dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_skeleton_line" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/rx_space_12"
            android:layout_weight="1"
            android:background="@color/rx_divider" />
    </LinearLayout>
</com.rainax.ytdownloader.RxShimmer>
