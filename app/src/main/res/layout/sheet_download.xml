<?xml version="1.0" encoding="utf-8"?>
<!-- Download sheet: picture + title, Video / Audio tabs, quality cards, and a bar with "Selected" + DOWNLOAD -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dl_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_dl_handle" />

    <!-- header: back (More formats), picture, title, close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/rx_space_20">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/rx_space_8"
            android:background="@drawable/bg_dl_close"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            app:tint="@color/dl_close_icon" />

        <FrameLayout
            android:id="@+id/dlThumbBox"
            android:layout_width="104dp"
            android:layout_height="64dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_dl_thumb"
            android:elevation="3dp">

            <ImageView
                android:id="@+id/dlThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/dlDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_margin="6dp"
                android:background="@drawable/bg_dl_duration"
                android:fontFamily="@font/rx_body"
                android:paddingHorizontal="6dp"
                android:paddingVertical="@dimen/rx_space_2"
                android:textColor="@color/rx_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="12:45" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:fontFamily="@font/rx_display"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:id="@+id/sheetHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.1"
                android:maxLines="2"
                android:textColor="@color/dl_text"
                android:textSize="20sp"
                tools:text="Mangroves Fishing | Karachi" />

            <TextView
                android:id="@+id/sheetSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rx_space_4"
                android:ellipsize="end"
                android:fontFamily="@font/rx_body"
                android:maxLines="2"
                android:textColor="@color/dl_text2"
                android:textSize="14sp"
                tools:text="Choose a format to download" />
        </LinearLayout>

        <ImageView
            android:id="@+id/closeBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/rx_space_8"
            android:background="@drawable/bg_dl_close"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/ic_dl_close" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/previewLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/rx_space_20"
        android:layout_marginTop="@dimen/rx_space_12"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/rxAccent"
        app:trackColor="@color/dl_tabs_bg"
        app:trackCornerRadius="2dp" />

    <LinearLayout
        android:id="@+id/errorBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/rx_space_20"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/rx_body"
            android:textColor="?attr/colorError"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryBtn"
            style="@style/Widget.Rainax.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rx_space_8"
            android:text="Retry" />
    </LinearLayout>

    <!-- (kept for the code that hides it) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/playlistBtn"
        style="@style/Widget.Rainax.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/rx_space_20"
        android:text="Download whole playlist"
        android:visibility="gone" />

    <!-- Video / Audio -->
    <LinearLayout
        android:id="@+id/dlTabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="@dimen/rx_space_20"
        android:layout_marginTop="@dimen/rx_space_20"
        android:background="@drawable/bg_dl_tabs"
        android:orientation="horizontal"
        android:padding="@dimen/rx_space_4">

        <LinearLayout
            android:id="@+id/tabVideo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/rx_space_2"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Video"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tabVideoIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dl_video" />

            <TextView
                android:id="@+id/tabVideoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/rx_space_8"
                android:fontFamily="@font/rx_body"
                android:text="Video"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabAudio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/rx_space_2"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Audio"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tabAudioIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dl_audio" />

            <TextView
                android:id="@+id/tabAudioText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/rx_space_8"
                android:fontFamily="@font/rx_body"
                android:text="Audio"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- cards (2 columns) or, in More formats, the full list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/formatList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="@dimen/rx_space_12"
        android:paddingBottom="@dimen/rx_space_12" />

    <!-- Selected + DOWNLOAD -->
    <LinearLayout
        android:id="@+id/dlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dl_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/rx_space_20"
        android:paddingTop="@dimen/rx_space_16"
        android:paddingBottom="@dimen/rx_space_20">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/rx_space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rx_body"
                android:text="Selected:"
                android:textColor="@color/dl_text2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selectedLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rx_space_2"
                android:ellipsize="end"
                android:fontFamily="@font/rx_body"
                android:maxLines="1"
                android:textColor="@color/dl_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="720p (280.0 MB)" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadBtn"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:backgroundTint="?attr/rxAccent"
            android:enabled="false"
            android:fontFamily="@font/rx_body"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.07"
            android:paddingHorizontal="28dp"
            android:text="DOWNLOAD"
            android:textColor="@color/rx_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="2dp"
            app:icon="@drawable/ic_dl_download"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="18dp"
            app:iconTint="@color/rx_white" />
    </LinearLayout>
</LinearLayout>
