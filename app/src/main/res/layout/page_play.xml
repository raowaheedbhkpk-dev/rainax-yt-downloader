<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- You (like YouTube): Accounts, bell, search, settings; your picture, name and @handle; View channel / Sign out -->
    <LinearLayout
        android:id="@+id/youHeader"
        android:layout_width="match_parent"
        android:layout_height="196dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/youAccounts"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:fontFamily="@font/rx_body"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="Accounts"
                android:textAllCaps="false"
                android:textColor="@color/rx_text"
                android:textSize="15sp"
                app:cornerRadius="2dp"
                app:icon="@drawable/ic_chevron_down"
                app:iconGravity="textEnd"
                app:iconSize="18dp"
                app:iconTint="@color/rx_text"
                app:strokeColor="@color/rx_outline" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/youBell"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Notifications"
                android:src="@drawable/ic_bell"
                app:tint="@color/rx_text" />

            <ImageButton
                android:id="@+id/youSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/rx_text" />

            <ImageButton
                android:id="@+id/youSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gear"
                app:tint="@color/rx_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/youProfile"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/youAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_avatar"
                android:importantForAccessibility="no"
                android:padding="0dp"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/youName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:textAllCaps="true"
                    android:fontFamily="@font/rx_display"
                    android:maxLines="1"
                    android:text="You"
                    android:textColor="@color/rx_text"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/youHandle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/rx_body"
                    android:maxLines="1"
                    android:text="Sign in to YouTube"
                    android:textColor="@color/rx_text2"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <!-- signed out: one red "Sign in" button (fixed colours, right in light and dark) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/youSignInBtn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:fontFamily="@font/rx_body"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@animator/rx_press"
                android:text="Sign in to YouTube"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/rx_primary"
                app:cornerRadius="2dp"
                app:icon="@drawable/ic_person"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/youMainBtn"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                app:backgroundTint="@color/rx_text"
                android:fontFamily="@font/rx_body"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@animator/rx_press"
                android:text="View channel"
                android:textAllCaps="false"
                android:textColor="?attr/rxBg"
                android:textSize="15sp"
                app:cornerRadius="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/youSecondBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/rx_body"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Sign out"
                android:textAllCaps="false"
                android:textColor="@color/rx_text"
                android:textSize="15sp"
                app:cornerRadius="2dp"
                app:strokeColor="@color/rx_outline" />
        </LinearLayout>
    </LinearLayout>

    <!-- Downloads / Music / Videos / Playlists -->
    <HorizontalScrollView
        android:id="@+id/libChipsScroll"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="196dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/libChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- Music, Videos and Playlists: your downloaded files, ready to play -->
    <LinearLayout
        android:id="@+id/libraryBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="248dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/libPlaylistBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/libPlaylistBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to playlists"
                android:src="@drawable/ic_back"
                app:tint="@color/rx_text" />

            <TextView
                android:id="@+id/libPlaylistName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/rx_text"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/libPlaylistMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Playlist options"
                android:src="@drawable/ic_more"
                app:tint="@color/rx_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/rx_text2" />

            <EditText
                android:id="@+id/libSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search your downloads"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/rx_text"
                android:textColorHint="@color/rx_text2"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/libSearchClear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/rx_text2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/libPlayAll"
                style="@style/Widget.Rainax.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Play all"
                app:cornerRadius="2dp"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/rx_on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/libShuffle"
                style="@style/Widget.Rainax.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Shuffle"
                app:cornerRadius="2dp"
                app:icon="@drawable/ic_shuffle"
                app:iconTint="@color/rx_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/libNewPlaylist"
                style="@style/Widget.Rainax.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="New playlist"
                android:visibility="gone"
                app:cornerRadius="2dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/rx_on_primary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/libList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="120dp" />

            <TextView
                android:id="@+id/libEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="80dp"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:textColor="@color/rx_text2"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- One recycling list for both sections: only the rows on screen exist, so 1000+ downloads stay smooth -->
    <FrameLayout
        android:id="@+id/playScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="244dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="96dp"
            android:scrollbars="vertical" />

        <!-- Section headers: moved into the list above when the page is set up -->
        <LinearLayout
            android:id="@+id/playHeaders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Downloading -->
            <LinearLayout
                android:id="@+id/activeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp">

                    <TextView
                        android:id="@+id/activeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearFailedBtn"
                        style="@style/Widget.Rainax.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear failed"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selectActiveBtn"
                        style="@style/Widget.Rainax.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select all"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="6dp"
                    android:text="Tip: tap Select all, or press and hold a download, then Pause, Resume or Cancel the selected ones"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Downloaded -->
            <LinearLayout
                android:id="@+id/doneSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/doneTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selectDoneBtn"
                        style="@style/Widget.Rainax.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Select all"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/removeAllBtn"
                        style="@style/Widget.Rainax.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Remove all"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteAllBtn"
                        style="@style/Widget.Rainax.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Delete all"
                        android:textColor="?attr/colorError"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="196dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- a soft red circle with the download arrow, a title, and one line of help -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_welcome_circle">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_download"
                app:tint="@color/rx_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAllCaps="true"
            android:fontFamily="@font/rx_display"
            android:gravity="center"
            android:text="No downloads yet"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/rx_body"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:paddingHorizontal="40dp"
            android:text="Tap Download under any video, or share a TikTok, Instagram or Facebook link to RAINAX."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptySearchBtn"
            style="@style/Widget.Rainax.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:minWidth="200dp"
            android:text="Explore videos"
            app:cornerRadius="2dp"
            app:icon="@drawable/ic_play"
            app:iconTint="@color/rx_on_primary" />
    </LinearLayout>

    <!-- Selection: top bar (count, all, exit) -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="?attr/rxSurface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeSelBtn"
            style="@style/Widget.Rainax.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Exit selection"
            app:icon="@drawable/ic_close" />

        <TextView
            android:id="@+id/selectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selAllBtn"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Selection: labelled actions at the bottom (only the ones that apply are shown) -->
    <LinearLayout
        android:id="@+id/selectionActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/rxSurface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actPause"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:text="Pause"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            app:icon="@drawable/ic_pause"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actResume"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:text="Resume"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            app:icon="@drawable/ic_play"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actCancel"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:text="Cancel"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            app:icon="@drawable/ic_close"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="?attr/colorError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actRemove"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:text="Remove"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            app:icon="@drawable/ic_remove"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actDelete"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:text="Delete"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="?attr/colorError" />
    </LinearLayout>
</FrameLayout>
