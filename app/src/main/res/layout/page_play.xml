<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- fits its 72dp row at any font size (the list starts below it) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:autoSizeMaxTextSize="34sp"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:fontFamily="@font/rx_display"
        android:text="Library"
        android:textColor="@color/rx_text" />

    <!-- Downloads / Music / Videos / Playlists -->
    <HorizontalScrollView
        android:id="@+id/libChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="68dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/libChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- Music, Videos and Playlists: your downloaded files, ready to play -->
    <LinearLayout
        android:id="@+id/libraryBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="120dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/libPlaylistBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/libPlaylistBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back to playlists"
                android:src="@drawable/ic_back"
                app:tint="@color/rx_text" />

            <TextView
                android:id="@+id/libPlaylistName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/rx_display_semibold"
                android:maxLines="1"
                android:textColor="@color/rx_text"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/libPlaylistMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Playlist options"
                android:src="@drawable/ic_more"
                app:tint="@color/rx_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/rx_text2" />

            <EditText
                android:id="@+id/libSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search your downloads"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/rx_text"
                android:textColorHint="@color/rx_text2"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/libSearchClear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/rx_text2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/libPlayAll"
                style="@style/Widget.Rainax.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Play all"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/rx_on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/libShuffle"
                style="@style/Widget.Rainax.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Shuffle"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_shuffle"
                app:iconTint="@color/rx_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/libNewPlaylist"
                style="@style/Widget.Rainax.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="New playlist"
                android:visibility="gone"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/rx_on_primary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/libList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="120dp" />

            <TextView
                android:id="@+id/libEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="80dp"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:textColor="@color/rx_text2"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/playScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="116dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="96dp">

            <!-- Downloading -->
            <LinearLayout
                android:id="@+id/activeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp">

                    <TextView
                        android:id="@+id/activeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearFailedBtn"
                        style="@style/Widget.Rainax.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear failed"
                        android:textColor="?attr/colorError"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selectActiveBtn"
                        style="@style/Widget.Rainax.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select all"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pauseAllBtn"
                        style="@style/Widget.Rainax.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Pause all"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/resumeAllBtn"
                        style="@style/Widget.Rainax.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Resume all"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelAllBtn"
                        style="@style/Widget.Rainax.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Cancel all"
                        android:textColor="?attr/colorError"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="6dp"
                    android:text="Tip: press and hold a download to select several"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/activeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- Downloaded -->
            <LinearLayout
                android:id="@+id/doneSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/doneTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selectDoneBtn"
                        style="@style/Widget.Rainax.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Select all"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/removeAllBtn"
                        style="@style/Widget.Rainax.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Remove all"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteAllBtn"
                        style="@style/Widget.Rainax.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        android:text="Delete all"
                        android:textColor="?attr/colorError"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/doneList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_ring"
            android:contentDescription="@null"
            android:padding="24dp"
            android:src="@drawable/ic_download"
            android:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="No downloads yet. Open a video on YouTube and tap the red Download button."
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptySearchBtn"
            style="@style/Widget.Rainax.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:minWidth="200dp"
            android:text="Browse YouTube"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_play"
            app:iconTint="@color/rx_on_primary" />
    </LinearLayout>

    <!-- Selection: top bar (count, all, exit) -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:background="?attr/rxSurface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeSelBtn"
            style="@style/Widget.Rainax.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Exit selection"
            app:icon="@drawable/ic_close" />

        <TextView
            android:id="@+id/selectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selAllBtn"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Selection: labelled actions at the bottom (only the ones that apply are shown) -->
    <LinearLayout
        android:id="@+id/selectionActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/rxSurface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actPause"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:text="Pause"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            app:icon="@drawable/ic_pause"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actResume"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:text="Resume"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            app:icon="@drawable/ic_play"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actCancel"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:text="Cancel"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            app:icon="@drawable/ic_close"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="?attr/colorError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actRemove"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:text="Remove"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            app:icon="@drawable/ic_remove"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actDelete"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingHorizontal="2dp"
            android:text="Delete"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconTint="?attr/colorError" />
    </LinearLayout>
</FrameLayout>
