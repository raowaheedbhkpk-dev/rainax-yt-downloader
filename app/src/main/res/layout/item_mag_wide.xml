<?xml version="1.0" encoding="utf-8"?>
<!-- Magazine Home: a pull quote. Picture, then the title as a quote with a red bar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="6dp"
    android:background="?attr/rxCard"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="124dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_thumb_big">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_duration"
            android:paddingHorizontal="4dp"
            android:textColor="@color/rx_white"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </FrameLayout>

    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:background="@color/rx_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/rx_text"
            android:textSize="14.5sp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rx_text2"
            android:textSize="11.5sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/download"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Download"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_download"
        app:tint="@color/rx_primary" />
</LinearLayout>
