<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/rx_space_12">

    <ImageView
        android:id="@+id/chBanner"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="?attr/rxSurfaceAlt"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/rx_space_16"
        android:paddingTop="14dp">

        <ImageView
            android:id="@+id/chHeadAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_avatar"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/rx_space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:fontFamily="@font/rx_body_bold"
                android:textAllCaps="false"
                android:letterSpacing="0.02"
                android:id="@+id/chHeadName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/rx_text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/chHeadMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rx_space_2"
                android:textColor="@color/rx_text2"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/chHeadDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/rx_space_16"
        android:layout_marginTop="@dimen/rx_space_12"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/rx_text2"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/chSubscribe"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="@dimen/rx_space_16"
        android:layout_marginTop="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Subscribe"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textStyle="bold"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Pill" />

    <!-- Videos / Shorts / Live / Playlists, like YouTube's channel tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/rx_space_16"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>
</LinearLayout>
