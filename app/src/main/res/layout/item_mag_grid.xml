<?xml version="1.0" encoding="utf-8"?>
<!-- Magazine Home: Editor's picks. One tall story on the left, two stacked on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="312dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/rx_space_16">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1.25">
        <FrameLayout
            android:id="@+id/g0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_thumb_big"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/g0Thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hero_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="@dimen/rx_space_12">

                <TextView
                    android:id="@+id/g0Tag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.18"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/rx_cinema_gold"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/g0Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/rx_display"
                    android:textAllCaps="true"
                    android:maxLines="4"
                    android:textColor="@color/rx_white"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/g0Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rx_space_4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/rx_cinema_text2"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">
        <FrameLayout
            android:id="@+id/g1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_thumb_big"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/g1Thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hero_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="9dp">

                <TextView
                    android:id="@+id/g1Tag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.18"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/rx_cinema_gold"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/g1Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:textColor="@color/rx_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/g1Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rx_space_4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/rx_cinema_text2"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp" />
        <FrameLayout
            android:id="@+id/g2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_thumb_big"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/g2Thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hero_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="9dp">

                <TextView
                    android:id="@+id/g2Tag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.18"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/rx_cinema_gold"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/g2Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:textColor="@color/rx_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/g2Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rx_space_4"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/rx_cinema_text2"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
