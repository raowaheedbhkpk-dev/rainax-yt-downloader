<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/rx_press"
    app:cardCornerRadius="2dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/selectBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="64dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_thumb"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.Rainax.Sharp" />

        <!-- while downloading: a film reel turning over the picture, like a projector, with the percent -->
        <LinearLayout
            android:id="@+id/reelBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/reel"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_film_reel"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/reelPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/rx_display"
                android:includeFontPadding="false"
                android:textColor="#E8B44A"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- pops in for a moment when a download finishes -->
        <ImageView
            android:id="@+id/doneCheck"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dl_check"
            android:elevation="4dp"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_dl_check"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Downloading / Queued / Paused / Failed (not shown when done) -->
            <TextView
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/rx_body"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:indicatorColor="?attr/rxAccent"
            app:trackColor="?attr/rxSurfaceAlt"
            app:trackCornerRadius="0dp"
            app:trackThickness="6dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/actionBtn"
        style="@style/Widget.Rainax.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:iconTint="?attr/rxAccent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeBtn"
        style="@style/Widget.Rainax.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Remove"
        app:icon="@drawable/ic_close"
        app:iconTint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
