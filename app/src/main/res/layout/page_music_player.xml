<?xml version="1.0" encoding="utf-8"?>
<!-- Music player, like YouTube Music: Song / Video switch, big cover, title, Like / Comments / Download / Share,
     seek bar, shuffle-previous-play-next-repeat, and Up next. The background takes the cover's colour (in code). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1E1E24"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- top: close, Song / Video, more -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/mpCollapse"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close player"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/rx_white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_mp_toggle"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/mpModeSong"
                    android:layout_width="60dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_mp_toggle_on"
                    android:contentDescription="Song"
                    android:padding="8dp"
                    android:src="@drawable/ic_headphones"
                    app:tint="@color/rx_white" />

                <ImageView
                    android:id="@+id/mpModeVideo"
                    android:layout_width="60dp"
                    android:layout_height="38dp"
                    android:contentDescription="Video"
                    android:padding="8dp"
                    android:src="@drawable/ic_video"
                    app:tint="@color/rx_white" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/mpMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:src="@drawable/ic_more"
                app:tint="@color/rx_white" />
        </LinearLayout>

        <!-- the cover (or the video), as big as fits -->
        <FrameLayout
            android:id="@+id/mpArtArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <com.rainax.ytdownloader.FitRatioLayout
                android:id="@+id/mpArtBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_mp_art"
                android:elevation="12dp">

                <ImageView
                    android:id="@+id/mpArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/mpVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/rx_black"
                    android:visibility="gone"
                    app:resize_mode="fit"
                    app:show_buffering="never"
                    app:shutter_background_color="@color/rx_black"
                    app:surface_type="texture_view"
                    app:use_controller="false" />

                <ProgressBar
                    android:id="@+id/mpArtLoading"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/rx_white"
                    android:visibility="gone" />
            </com.rainax.ytdownloader.FitRatioLayout>
        </FrameLayout>

        <!-- title and artist -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/mpTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:fontFamily="@font/rx_display_semibold"
                android:letterSpacing="-0.01"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="@color/rx_white"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/mpArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Like | Dislike, Comments, Download, Share -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_mp_toggle"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/mpLike"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_mp_pill"
                        android:contentDescription="Like"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/mpLikeIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_thumb_up"
                            app:tint="@color/rx_white" />

                        <TextView
                            android:id="@+id/mpLikeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Like"
                            android:textColor="@color/rx_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:background="#40FFFFFF" />

                    <FrameLayout
                        android:id="@+id/mpDislike"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_mp_pill"
                        android:contentDescription="Dislike">

                        <ImageView
                            android:id="@+id/mpDislikeIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_thumb_down"
                            app:tint="@color/rx_white" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mpComments"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mp_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_comment"
                        app:tint="@color/rx_white" />

                    <TextView
                        android:id="@+id/mpCommentsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Comments"
                        android:textColor="@color/rx_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mpDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mp_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_download"
                        app:tint="@color/rx_white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Download"
                        android:textColor="@color/rx_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mpShare"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_mp_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_share"
                        app:tint="@color/rx_white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Share"
                        android:textColor="@color/rx_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- seek bar and times -->
        <SeekBar
            android:id="@+id/mpSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:max="1000"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:progressBackgroundTint="#4DFFFFFF"
            android:progressTint="@color/rx_white"
            android:secondaryProgressTint="#66FFFFFF"
            android:splitTrack="false"
            android:thumbTint="@color/rx_white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/mpPos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/mpDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- shuffle, previous, play, next, repeat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/mpShuffle"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Shuffle"
                android:src="@drawable/ic_shuffle"
                app:tint="@color/rx_white" />

            <ImageButton
                android:id="@+id/mpPrev"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_p_prev"
                app:tint="@color/rx_white" />

            <FrameLayout
                android:id="@+id/mpPlay"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_mp_play"
                android:contentDescription="Play or pause"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/mpPlayIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_p_pause"
                    app:tint="@color/rx_black" />

                <ProgressBar
                    android:id="@+id/mpBuffering"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:indeterminateTint="#55000000"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/mpNext"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_p_next"
                app:tint="@color/rx_white" />

            <ImageButton
                android:id="@+id/mpRepeat"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Repeat"
                android:src="@drawable/ic_repeat"
                app:tint="@color/rx_white" />
        </LinearLayout>

        <!-- Up next -->
        <LinearLayout
            android:id="@+id/mpUpNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="14dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_mp_handle" />

            <TextView
                android:id="@+id/mpUpNextText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/rx_body"
                android:maxLines="1"
                android:text="Up next"
                android:textColor="@color/rx_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
