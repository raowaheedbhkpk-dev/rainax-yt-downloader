<?xml version="1.0" encoding="utf-8"?>
<!-- Music player, like YouTube Music. Drawn with Jetpack Compose (MusicPage.kt); the cover / video is
     layout_music_art.xml inside it. The background takes the cover's colour (in code). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1E1E24"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/mpCompose"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
