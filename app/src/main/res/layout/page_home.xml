<?xml version="1.0" encoding="utf-8"?>
<!-- Home: brand bar (search opens in place), filter chips, and the video list (Download on every video). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <!-- Brand bar -->
        <LinearLayout
            android:id="@+id/brandBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <!-- RAINAX Tube logo: the RAINAX mark + wordmark -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="RAINAX Tube"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:elevation="2dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/rx_display"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="RAINAX"
                    android:textColor="@color/rx_text"
                    android:textSize="21sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/rx_display_semibold"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="Tube"
                    android:textColor="@color/rx_primary"
                    android:textSize="21sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/searchOpen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/rx_text" />

            <FrameLayout
                android:id="@+id/accountBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="YouTube account">

                <ImageView
                    android:id="@+id/accountIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:tint="@color/rx_text" />
            </FrameLayout>
        </LinearLayout>

        <!-- Playlist page: back, name, Download all -->
        <LinearLayout
            android:id="@+id/titleBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/titleBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/rx_text" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/rx_text"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/titleDownload"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="Download all"
                android:textAllCaps="false"
                android:textColor="@color/rx_on_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/rx_primary"
                app:icon="@drawable/ic_download"
                app:iconSize="18dp"
                app:iconTint="@color/rx_on_primary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Pill" />
        </LinearLayout>

        <!-- Search box (replaces the brand bar while searching) -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/searchBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/rx_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search or paste a link"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/rx_text"
                    android:textColorHint="@color/rx_text2"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/searchClear"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/rx_text2" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- filter chips: their own row with space above and below, so the list never touches them -->
    <HorizontalScrollView
        android:id="@+id/chipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/homeChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/feedRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/feedList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="0dp"
                android:paddingBottom="16dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/suggestList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/rxAmbient"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/feedLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/rx_primary" />

        <LinearLayout
            android:id="@+id/feedError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cloud_off"
                app:tint="@color/rx_text2" />

            <TextView
                android:id="@+id/feedErrorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/rx_text2"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feedRetry"
                style="@style/Widget.Rainax.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Try again" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feedSettings"
                style="@style/Widget.Rainax.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Internet settings"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Several videos picked with +: how many, Clear, Download all -->
        <LinearLayout
            android:id="@+id/pickBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_glass_nav"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/pickCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/rx_text"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickClear"
                style="@style/Widget.Rainax.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickDownload"
                style="@style/Widget.Rainax.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Download"
                app:cornerRadius="22dp"
                app:icon="@drawable/ic_download"
                app:iconTint="@color/rx_on_primary" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
