<?xml version="1.0" encoding="utf-8"?>
<!-- Home: brand bar (search opens in place), filter chips, and the video list (Download on every video). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- brand bar / search box / title bar, and the chips: Jetpack Compose (HomeTop.kt) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/homeTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/feedRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- every Home list and the Music tab: Jetpack Compose (FeedCompose.kt, MusicHome.kt) -->
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/feedCompose"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- pull to refresh: a film countdown (3 · 2 · 1) while the new list loads -->
        <TextView
            android:id="@+id/feedCountdown"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_countdown"
            android:elevation="6dp"
            android:fontFamily="@font/rx_display"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:textColor="@color/rx_white"
            android:textSize="24sp"
            android:visibility="gone" />

        <!-- search suggestions, the spinner, the error message and the picks bar (HomeTop.kt) -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/homeOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
