<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rxAmbient"
    android:forceDarkAllowed="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/homePage"
                layout="@layout/page_home" />

            <!-- You: a Jetpack Compose screen (YouScreen.kt) -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/playPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Social: a Jetpack Compose screen (SocialScreen.kt) -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/socialPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Subscriptions: a Jetpack Compose screen (SubsScreen.kt) -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/subsPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Settings: a Jetpack Compose screen (SettingsScreen.kt) -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/settingsPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/videoPage"
                layout="@layout/page_video"
                android:visibility="gone" />

            <!-- app update: a small pill above the bottom bar while the new version downloads by itself,
                 then "vX READY · INSTALL" (filled in by MainActivity.renderUpdatePill) -->
            <LinearLayout
                android:id="@+id/updatePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/rx_space_12"
                android:background="@drawable/bg_update_pill"
                android:clickable="true"
                android:elevation="10dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp"
                android:paddingStart="@dimen/rx_space_8"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/updateRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        app:indicatorColor="@color/rx_cinema_gold"
                        app:indicatorSize="28dp"
                        app:trackColor="@color/rx_cinema_track"
                        app:trackThickness="3dp" />

                    <View
                        android:id="@+id/updateDot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_gravity="center"
                        android:background="?attr/rxAccent"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/updateTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/rx_display"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.03"
                        android:textColor="@color/rx_white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/updateSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rx_space_2"
                        android:maxWidth="170dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/rx_cinema_text3"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/updateAction"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="@dimen/rx_space_12"
                    android:background="?attr/rxAccent"
                    android:gravity="center"
                    android:letterSpacing="0.15"
                    android:paddingHorizontal="14dp"
                    android:text="Install"
                    android:textAllCaps="true"
                    android:textColor="@color/rx_white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- mini music bar (while songs play in the Music player) -->
        <include
            android:id="@+id/musicMini"
            layout="@layout/layout_music_mini"
            android:visibility="gone" />

        <!-- bottom bar (Cinema Pro "Ticket"): a flat strip, a red bar above the chosen tab, a red square "+" in the middle -->
        <com.rainax.ytdownloader.RxNavBar
            android:id="@+id/navCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:background="@android:color/transparent"
                app:itemPaddingBottom="8dp"
                app:itemPaddingTop="9dp"
                app:itemTextAppearanceActive="@style/TextAppearance.Rainax.Nav"
                app:itemTextAppearanceInactive="@style/TextAppearance.Rainax.Nav"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />

            <!-- the red square "+" (Add: download from a link); placed in the middle of the strip by RxNavBar -->
            <FrameLayout
                android:id="@+id/navFab"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_nav_fab"
                android:clickable="true"
                android:contentDescription="Add: download from a link"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_plus" />
            </FrameLayout>
        </com.rainax.ytdownloader.RxNavBar>
    </LinearLayout>

    <!-- floating mini player (placed and dragged in code) -->
    <include
        android:id="@+id/miniPlayer"
        layout="@layout/layout_mini_player"
        android:layout_width="208dp"
        android:layout_height="117dp"
        android:layout_gravity="top|start" />

    <!-- side menu -->
    <include
        android:id="@+id/explore"
        layout="@layout/layout_explore"
        android:visibility="gone" />

    <!-- the big Music player (over everything, like YouTube Music) -->
    <include
        android:id="@+id/musicPage"
        layout="@layout/page_music_player"
        android:visibility="gone" />

</FrameLayout>
