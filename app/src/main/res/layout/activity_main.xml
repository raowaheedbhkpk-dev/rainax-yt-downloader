<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rxAmbient"
    android:forceDarkAllowed="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/homePage"
                layout="@layout/page_home" />

            <include
                android:id="@+id/playPage"
                layout="@layout/page_play"
                android:visibility="gone" />

            <include
                android:id="@+id/socialPage"
                layout="@layout/page_social"
                android:visibility="gone" />

            <include
                android:id="@+id/subsPage"
                layout="@layout/page_subs"
                android:visibility="gone" />

            <include
                android:id="@+id/settingsPage"
                layout="@layout/page_settings"
                android:visibility="gone" />

            <include
                android:id="@+id/videoPage"
                layout="@layout/page_video"
                android:visibility="gone" />
        </FrameLayout>

        <!-- mini music bar (while songs play in the Music player) -->
        <include
            android:id="@+id/musicMini"
            layout="@layout/layout_music_mini"
            android:visibility="gone" />

        <!-- bottom bar: a floating rounded bar, the raised "+" button in its middle, and a dot that jumps to the chosen tab -->
        <com.rainax.ytdownloader.RxNavBar
            android:id="@+id/navCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="28dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@android:color/transparent"
                app:labelVisibilityMode="unlabeled"
                app:menu="@menu/bottom_nav" />

            <!-- the raised "+" (Add: download from a link); placed on the bar's top edge by RxNavBar -->
            <FrameLayout
                android:id="@+id/navFab"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_nav_fab"
                android:clickable="true"
                android:contentDescription="Add: download from a link"
                android:elevation="8dp"
                android:focusable="true"
                android:outlineAmbientShadowColor="@color/rx_primary"
                android:outlineSpotShadowColor="@color/rx_primary">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_plus" />
            </FrameLayout>
        </com.rainax.ytdownloader.RxNavBar>
    </LinearLayout>

    <!-- floating mini player (placed and dragged in code) -->
    <include
        android:id="@+id/miniPlayer"
        layout="@layout/layout_mini_player"
        android:layout_width="208dp"
        android:layout_height="117dp"
        android:layout_gravity="top|start" />

    <!-- side menu -->
    <include
        android:id="@+id/explore"
        layout="@layout/layout_explore"
        android:visibility="gone" />

    <!-- the big Music player (over everything, like YouTube Music) -->
    <include
        android:id="@+id/musicPage"
        layout="@layout/page_music_player"
        android:visibility="gone" />

</FrameLayout>
