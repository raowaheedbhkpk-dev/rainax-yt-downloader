<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen player: the video, and over it the buttons drawn with Jetpack Compose (PlayerOverlay.kt) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rx_black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:shutter_background_color="@color/rx_black"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/playerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
