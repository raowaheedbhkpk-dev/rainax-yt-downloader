<?xml version="1.0" encoding="utf-8"?>
<!-- one tall poster in a magazine chapter row -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="132dp"
    android:layout_height="196dp"
    android:layout_marginHorizontal="@dimen/rx_space_4"
    android:background="@drawable/bg_thumb_big"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_duration"
        android:paddingHorizontal="@dimen/rx_space_4"
        android:textColor="@color/rx_white"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="9dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/rx_display"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:textAllCaps="false"
            android:textColor="@color/rx_white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rx_space_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rx_cinema_text2"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
