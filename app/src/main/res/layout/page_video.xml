<?xml version="1.0" encoding="utf-8"?>
<!-- Video page: in-app player, Download / audio buttons, comments and related videos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rxAmbient"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.rainax.ytdownloader.RatioFrameLayout
        android:id="@+id/playerBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rx_black">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:played_color="@color/rx_primary"
            app:resize_mode="fit"
            app:scrubber_color="@color/rx_primary"
            app:show_buffering="when_playing"
            app:show_shuffle_button="false"
            app:show_subtitle_button="false" />

        <!-- the video's picture until the first frame shows -->
        <ImageView
            android:id="@+id/playerThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/playerLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/rx_white"
            app:indicatorSize="40dp" />

        <!-- top controls (shown with the player controls) -->
        <LinearLayout
            android:id="@+id/playerTop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_player_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageButton
                android:id="@+id/videoClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/rx_white" />

            <!-- the title (full screen only, like YouTube) -->
            <TextView
                android:id="@+id/playerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/rx_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/qualityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_duration"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/rx_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/videoSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quality and speed"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gear"
                app:tint="@color/rx_white" />
        </LinearLayout>

        <!-- Lock screen (from the gear menu): touches do nothing until Unlock -->
        <FrameLayout
            android:id="@+id/playerLock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/playerUnlock"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:alpha="0.85"
                android:background="@drawable/bg_mini_button"
                android:contentDescription="Unlock screen"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lock_open"
                app:tint="@color/rx_white" />
        </FrameLayout>
    </com.rainax.ytdownloader.RatioFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/videoList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Videos picked with + : how many, Clear, Download all (same picks as on Home) -->
    <LinearLayout
        android:id="@+id/vPickBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/vPickCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/rx_text"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vPickClear"
            style="@style/Widget.Rainax.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vPickDownload"
            style="@style/Widget.Rainax.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Download"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_download"
            app:iconTint="@color/rx_on_primary" />
    </LinearLayout>

    <!-- Next video / Mix bar at the bottom (tap: the Up next list), like YouTube -->
    <LinearLayout
        android:id="@+id/vNextBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_radio"
            app:tint="@color/rx_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vNextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/rx_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vNextFrom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/rx_text2"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/rx_text" />
    </LinearLayout>
</LinearLayout>
