<?xml version="1.0" encoding="utf-8"?>
<!-- Video page: in-app player, Download / audio buttons, comments and related videos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rxBg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.rainax.ytdownloader.RatioFrameLayout
        android:id="@+id/playerBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rx_black">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:show_shuffle_button="false"
            app:show_subtitle_button="false" />

        <ImageButton
            android:id="@+id/videoClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/rx_white" />
    </com.rainax.ytdownloader.RatioFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/videoList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
