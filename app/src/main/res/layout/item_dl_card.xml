<?xml version="1.0" encoding="utf-8"?>
<!-- One quality card of the download sheet, drawn as a ticket (TicketDrawable): the size sits on the tear-off
     stub. The "Recommended" pill sits over its top edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="6dp"
    android:paddingBottom="@dimen/rx_space_12">

    <LinearLayout
        android:id="@+id/card"
        android:stateListAnimator="@animator/rx_press"
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:layout_marginTop="11dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="@dimen/rx_space_16">

        <TextView
            android:id="@+id/cardTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rx_body"
            android:textColor="@color/dl_text2"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="High Quality" />

        <TextView
            android:fontFamily="@font/rx_display"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            android:id="@+id/cardQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rx_space_2"
            android:includeFontPadding="false"
            android:textColor="@color/dl_text"
            android:textSize="32sp"
            tools:text="720p" />

        <TextView
            android:id="@+id/cardSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rx_space_12"
            android:fontFamily="@font/rx_body"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="280.0 MB" />
    </LinearLayout>

    <ImageView
        android:id="@+id/cardCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="23dp"
        android:layout_marginEnd="@dimen/rx_space_12"
        android:background="@drawable/bg_dl_check"
        android:elevation="8dp"
        android:importantForAccessibility="no"
        android:padding="@dimen/rx_space_4"
        android:src="@drawable/ic_dl_check"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cardBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:background="@drawable/bg_dl_badge"
        android:elevation="8dp"
        android:fontFamily="@font/rx_body"
        android:paddingHorizontal="10dp"
        android:paddingVertical="@dimen/rx_space_4"
        android:text="Recommended"
        android:textColor="@color/rx_white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
