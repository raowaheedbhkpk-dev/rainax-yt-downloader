<?xml version="1.0" encoding="utf-8"?>
<!-- Magazine Home: a chapter (Music, Gaming, News...): the section opener and a row of tall posters -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/magHead"
        layout="@layout/item_mag_section" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="206dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/magRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/rx_space_12" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/magLoading"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>
</LinearLayout>
