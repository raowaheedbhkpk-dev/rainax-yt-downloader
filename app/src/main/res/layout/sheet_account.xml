<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <ImageView
        android:id="@+id/accAvatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_avatar"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/accName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/rx_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/accHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/rx_text2"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Your recommendations, subscriptions, history and liked videos are on Home. Your sign-in stays on this phone."
        android:textColor="@color/rx_text2"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/accSignOut"
        style="@style/Widget.Rainax.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Sign out" />
</LinearLayout>
