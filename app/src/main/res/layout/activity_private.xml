<?xml version="1.0" encoding="utf-8"?>
<!-- Private folder: the lock (PIN, pattern or password), then the hidden videos and music -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rxBg"
    android:fitsSystemWindows="true">

    <!-- ===== lock ===== -->
    <ScrollView
        android:id="@+id/lockView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/lockClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/rx_text" />

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_private_badge">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/lockTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/rx_text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/lockSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/rx_text2"
                android:textSize="14sp" />

            <!-- first time: which kind of lock -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/lockTypes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/typePin"
                    style="@style/Widget.Rainax.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="PIN" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/typePattern"
                    style="@style/Widget.Rainax.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Pattern" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/typePassword"
                    style="@style/Widget.Rainax.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Password" />
            </com.google.android.material.chip.ChipGroup>

            <!-- PIN: dots and a number pad -->
            <TextView
                android:id="@+id/pinDots"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:letterSpacing="0.5"
                android:textColor="@color/rx_text"
                android:textSize="26sp" />

            <GridLayout
                android:id="@+id/pinPad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3" />

            <com.rainax.ytdownloader.PatternView
                android:id="@+id/patternView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <!-- password -->
            <LinearLayout
                android:id="@+id/passwordBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_search"
                    android:hint="Password"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingHorizontal="18dp"
                    android:textColor="@color/rx_text"
                    android:textColorHint="@color/rx_text2"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/passwordOk"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Continue"
                    app:cornerRadius="2dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/lockBusy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="16dp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/lockForgot"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Forgot?"
                android:textColor="@color/rx_text2"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== the folder ===== -->
    <LinearLayout
        android:id="@+id/vaultView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/vaultBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/rx_text" />

            <TextView
                android:fontFamily="@font/rx_display"
                android:textAllCaps="true"
                android:letterSpacing="0.02"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Private folder"
                android:textColor="@color/rx_text"
                android:textSize="22sp" />

            <ImageButton
                android:id="@+id/vaultMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more"
                app:tint="@color/rx_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/vaultCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/rx_text2"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vaultList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/vaultEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="36dp"
                android:text="Nothing here yet.\n\nIn Downloads or Library, tap ⋮ on a video or song, then “Move to Private folder”. It disappears from your gallery and other apps."
                android:textColor="@color/rx_text2"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
