<?xml version="1.0" encoding="utf-8"?>
<!-- Required update: logo, new version, what's new, and one big red Update button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dl_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/rx_space_24"
    android:paddingBottom="@dimen/rx_space_20">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dl_handle" />

    <ImageView
        android:id="@+id/updLogo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="22dp"
        android:elevation="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_logo" />

    <TextView
        android:id="@+id/updTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_16"
        android:textAllCaps="true"
        android:fontFamily="@font/rx_display"
        android:text="New version available"
        android:textColor="@color/dl_text"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/updVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_8"
        android:background="@drawable/bg_upd_chip"
        android:fontFamily="@font/rx_body"
        android:paddingHorizontal="@dimen/rx_space_12"
        android:paddingVertical="@dimen/rx_space_4"
        android:textColor="?attr/rxAccentText"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_20"
        android:fontFamily="@font/rx_body"
        android:letterSpacing="0.1"
        android:text="WHAT'S NEW"
        android:textColor="@color/dl_text2"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- what's new scrolls inside a limited height (set in code), so Update now always stays on screen -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/updNotesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_8">

        <LinearLayout
            android:id="@+id/updNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_upd_notes"
            android:orientation="vertical"
            android:padding="14dp" />
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/updInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_12"
        android:fontFamily="@font/rx_body"
        android:gravity="center"
        android:textColor="@color/dl_text2"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/updNow"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/rx_space_16"
        android:backgroundTint="?attr/rxAccent"
        android:fontFamily="@font/rx_body"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.05"
        android:text="Update now"
        android:textColor="@color/rx_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="2dp"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconTint="@color/rx_white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/updClose"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_4"
        android:fontFamily="@font/rx_body"
        android:text="Close app"
        android:textColor="@color/dl_text2" />
</LinearLayout>
