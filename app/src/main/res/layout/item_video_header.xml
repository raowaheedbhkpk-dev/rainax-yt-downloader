<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/vTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:lineSpacingExtra="1dp"
        android:textColor="@color/rx_text"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/vMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/rx_text2"
        android:textSize="13sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/vLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/rx_primary" />

    <TextView
        android:id="@+id/vError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:textColor="@color/rx_error"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/vChannelRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <ImageView
            android:id="@+id/vAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vUploader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/rx_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vSubs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/rx_text2"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vSubscribe"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:text="Subscribe"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Pill" />
    </LinearLayout>

    <!-- Actions: Download (main), Share, Copy link -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vDownload"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="22dp"
                android:text="Download"
                android:textAllCaps="false"
                android:textColor="@color/rx_on_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/rx_primary"
                app:icon="@drawable/ic_download"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@color/rx_on_primary"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Pill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vChapters"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="Chapters"
                android:textAllCaps="false"
                android:textColor="@color/rx_text"
                android:textSize="14sp"
                android:visibility="gone"
                app:backgroundTint="?attr/rxSurfaceAlt"
                app:icon="@drawable/ic_chapters"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/rx_text"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Pill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vLike"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="Like"
                android:textAllCaps="false"
                android:textColor="@color/rx_text"
                android:textSize="14sp"
                android:visibility="gone"
                app:backgroundTint="?attr/rxSurfaceAlt"
                app:icon="@drawable/ic_thumb_up"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/rx_text"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Pill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vDislike"
                android:contentDescription="Dislike"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text=""
                android:textAllCaps="false"
                android:textColor="@color/rx_text"
                android:textSize="14sp"
                android:visibility="gone"
                app:backgroundTint="?attr/rxSurfaceAlt"
                app:icon="@drawable/ic_thumb_down"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/rx_text"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Pill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vSave"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="@color/rx_text"
                android:textSize="14sp"
                android:visibility="gone"
                app:backgroundTint="?attr/rxSurfaceAlt"
                app:icon="@drawable/ic_watch_later"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/rx_text"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Pill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vShare"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="18dp"
                android:text="Share"
                android:textAllCaps="false"
                android:textColor="@color/rx_text"
                android:textSize="14sp"
                app:backgroundTint="?attr/rxSurfaceAlt"
                app:icon="@drawable/ic_share"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/rx_text"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Pill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vCopy"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="18dp"
                android:text="Copy link"
                android:textAllCaps="false"
                android:textColor="@color/rx_text"
                android:textSize="14sp"
                app:backgroundTint="?attr/rxSurfaceAlt"
                app:icon="@drawable/ic_link"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/rx_text"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Rainax.Pill" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/vComments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/rxSurfaceAlt"
        app:cardCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comments"
                android:textColor="@color/rx_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/vCommentAvatar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_avatar"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/vCommentText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/rx_text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/vDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:background="?attr/selectableItemBackground"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/rx_text2"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/vUpNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="4dp"
        android:text="Up next"
        android:textColor="@color/rx_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
