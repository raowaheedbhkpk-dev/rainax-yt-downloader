<?xml version="1.0" encoding="utf-8"?>
<!-- Cinema Pro: the first video on Home as a tall movie poster with a big title, Play and Download -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="22dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:background="@color/rx_black">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_scrim" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/rx_space_12"
            android:background="@drawable/bg_duration"
            android:paddingHorizontal="6dp"
            android:paddingVertical="@dimen/rx_space_2"
            android:textColor="@color/rx_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/watchBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressDrawable="@drawable/bg_watch_bar"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_tag"
                android:letterSpacing="0.01"
                android:paddingHorizontal="@dimen/rx_space_8"
                android:paddingVertical="3dp"
                android:text="Top pick"
                android:textAllCaps="false"
                android:textColor="@color/rx_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/rx_body_bold"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.02"
                android:maxLines="3"
                android:textAllCaps="false"
                android:textColor="@color/rx_white"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rx_space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="@dimen/rx_space_8"
                    android:background="@drawable/bg_avatar"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/rx_on_picture_strong"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/more"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More"
                    android:src="@drawable/ic_more"
                    android:visibility="gone"
                    app:tint="@color/rx_white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rx_space_16"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/heroPlay"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0.01"
                    android:text="Play"
                    android:textAllCaps="false"
                    android:textColor="@color/rx_black"
                    app:backgroundTint="@color/rx_white"
                    app:cornerRadius="2dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconTint="@color/rx_black" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/download"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:contentDescription="Download"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:letterSpacing="0.01"
                    android:text="Download"
                    android:textAllCaps="false"
                    android:textColor="@color/rx_white"
                    app:backgroundTint="?attr/rxAccent"
                    app:cornerRadius="2dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconTint="@color/rx_white" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
