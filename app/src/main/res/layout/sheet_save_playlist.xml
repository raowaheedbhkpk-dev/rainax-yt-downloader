<?xml version="1.0" encoding="utf-8"?>
<!-- "Save video to…" (your YouTube playlists), like YouTube -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/rx_space_12">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:fontFamily="@font/rx_display"
        android:paddingHorizontal="@dimen/rx_space_20"
        android:paddingTop="@dimen/rx_space_20"
        android:paddingBottom="@dimen/rx_space_8"
        android:text="Save video to…"
        android:textColor="@color/rx_text"
        android:textSize="20sp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/spLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="?attr/rxAccent" />

    <TextView
        android:id="@+id/spEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/rx_body"
        android:paddingHorizontal="@dimen/rx_space_20"
        android:paddingVertical="@dimen/rx_space_12"
        android:textColor="@color/rx_text2"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/spList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/rx_space_4"
        android:background="@color/rx_divider" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/spNew"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/rx_space_8"
        android:fontFamily="@font/rx_body"
        android:text="New playlist"
        android:textAllCaps="false"
        android:textColor="@color/rx_text"
        android:textSize="14sp"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/rx_text" />
</LinearLayout>
