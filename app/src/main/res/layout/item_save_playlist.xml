<?xml version="1.0" encoding="utf-8"?>
<!-- "Save video to…": a tick box, the playlist name and whether it is private -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/rx_space_12">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/spCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        app:buttonTint="?attr/rxAccent" />

    <TextView
        android:id="@+id/spTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rx_space_8"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/rx_body"
        android:maxLines="1"
        android:textColor="@color/rx_text"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/spPrivacy"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="@dimen/rx_space_8"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_lock"
        app:tint="@color/rx_text2" />
</LinearLayout>
