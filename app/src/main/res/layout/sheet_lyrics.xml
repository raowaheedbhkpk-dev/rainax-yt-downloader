<?xml version="1.0" encoding="utf-8"?>
<!-- Lyrics (Music player): a dark cinema sheet; the words centred like subtitles, YouTube Music's source under them -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/rx_cinema_bg"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/rx_cinema_line" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_16"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:text="Lyrics"
        android:textAllCaps="true"
        android:textColor="@color/rx_cinema_gold"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/rx_space_24"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/rx_display"
        android:gravity="center"
        android:maxLines="2"
        android:textAllCaps="true"
        android:textColor="@color/rx_white"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/lyArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rx_space_2"
        android:gravity="center"
        android:textColor="@color/rx_cinema_text3"
        android:textSize="14sp" />

    <View
        android:layout_width="44dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/rx_space_12"
        android:background="?attr/rxAccent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="420dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/lyScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/rx_space_24"
            android:paddingTop="18dp"
            android:paddingBottom="@dimen/rx_space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.45"
                    android:textColor="@color/rx_cinema_text"
                    android:textIsSelectable="false"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/lySource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rx_space_20"
                    android:gravity="center"
                    android:textColor="@color/rx_cinema_text4"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/lyLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/lyEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="@dimen/rx_space_32"
            android:textColor="@color/rx_cinema_text3"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
