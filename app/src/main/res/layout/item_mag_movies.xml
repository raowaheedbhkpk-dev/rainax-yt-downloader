<?xml version="1.0" encoding="utf-8"?>
<!-- Magazine Home: the Movies section. A dark cinema band (in every theme) with gold marquee lights,
     NOW SHOWING in big spaced letters, and a row of cinema tickets -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="26dp"
    android:background="#050505"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_marquee_bulbs"
        android:layerType="software" />

    <TextView
        android:id="@+id/movLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/rx_display"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.22"
        android:shadowColor="#99E8B44A"
        android:shadowRadius="14"
        android:text="Now showing"
        android:textAllCaps="true"
        android:textColor="#E8B44A"
        android:textSize="32sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/movRow"
        android:layout_width="match_parent"
        android:layout_height="196dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp" />

    <TextView
        android:id="@+id/movMore"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:paddingHorizontal="12dp"
        android:text="All movies  ›"
        android:textAllCaps="true"
        android:textColor="#E8B44A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_marquee_bulbs"
        android:layerType="software" />
</LinearLayout>
