<?xml version="1.0" encoding="utf-8"?>
<!-- one downloaded file on the collection shelf, like a DVD case: a red spine, the picture as the cover, the title -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="108dp"
    android:layout_height="156dp"
    android:layout_marginHorizontal="5dp"
    android:background="#1A1A1A"
    android:elevation="3dp"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/caseThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="7dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="7dp"
        android:background="@drawable/bg_hero_scrim" />

    <!-- the spine -->
    <View
        android:layout_width="7dp"
        android:layout_height="match_parent"
        android:background="?attr/rxAccent" />

    <TextView
        android:id="@+id/caseKind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:background="@drawable/bg_hero_tag"
        android:letterSpacing="0.1"
        android:paddingHorizontal="5dp"
        android:paddingVertical="1dp"
        android:textColor="#000000"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/caseTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="7dp"
        android:ellipsize="end"
        android:fontFamily="@font/rx_display"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:padding="7dp"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp" />
</FrameLayout>
