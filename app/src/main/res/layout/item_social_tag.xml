<?xml version="1.0" encoding="utf-8"?>
<!-- Social page: one app tag (its icon or coloured badge, then its name); tap opens the app -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginEnd="@dimen/rx_space_8"
    android:background="@drawable/bg_social_tag"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/tagBadge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/rx_white"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tagName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rx_space_8"
        android:importantForAccessibility="no"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/rx_text"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
