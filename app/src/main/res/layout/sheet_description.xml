<?xml version="1.0" encoding="utf-8"?>
<!-- Description: title, stats, chapters (tap to jump) and the full text with working links and timestamps -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="@dimen/rx_space_32">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rx_space_16"
            android:letterSpacing="0.08"
            android:text="DESCRIPTION"
            android:textColor="?attr/rxAccentText"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/descTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/rx_body_semibold"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/rx_text"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rx_space_16"
            android:background="@drawable/bg_desc_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/descLikes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:fontFamily="@font/rx_body_semibold"
                    android:textColor="@color/rx_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rx_space_2"
                    android:text="Likes"
                    android:textColor="@color/rx_text2"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="?attr/rxOutline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/descViews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:fontFamily="@font/rx_body_semibold"
                    android:textColor="@color/rx_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rx_space_2"
                    android:text="Views"
                    android:textColor="@color/rx_text2"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="?attr/rxOutline" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/descDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:fontFamily="@font/rx_body_semibold"
                    android:textColor="@color/rx_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rx_space_2"
                    android:text="Uploaded"
                    android:textColor="@color/rx_text2"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/descChapterBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rx_space_20"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/rx_space_8"
                android:letterSpacing="0.08"
                android:text="CHAPTERS"
                android:textColor="?attr/rxAccentText"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/descChapters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_desc_card"
                android:orientation="vertical"
                android:paddingVertical="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rx_space_20"
            android:layout_marginBottom="@dimen/rx_space_8"
            android:letterSpacing="0.08"
            android:text="ABOUT THIS VIDEO"
            android:textColor="?attr/rxAccentText"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/descText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_desc_card"
            android:lineSpacingExtra="5dp"
            android:padding="@dimen/rx_space_16"
            android:textColor="@color/rx_text"
            android:textColorLink="?attr/rxAccent"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
