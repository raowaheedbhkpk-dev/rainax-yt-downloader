<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- One theme for light and dark. Colours come from values/colors.xml and values-night/colors.xml,
         so every screen follows the same palette. forceDarkAllowed=false stops phone makers
         (Xiaomi/MIUI, Oppo, ...) from re-colouring the app on their own. -->
    <style name="Theme.Rainax" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Surface colours as theme attributes, so the AMOLED theme can turn them pure black -->
        <item name="rxBg">@color/rx_bg</item>
        <item name="rxSurface">@color/rx_surface</item>
        <item name="rxCard">@color/rx_card</item>
        <item name="rxSurfaceAlt">@color/rx_surface_alt</item>
        <item name="rxOutline">@color/rx_outline</item>
        <item name="colorPrimary">@color/rx_primary</item>
        <item name="colorOnPrimary">@color/rx_on_primary</item>
        <item name="colorPrimaryContainer">@color/rx_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/rx_on_primary_container</item>
        <item name="colorSecondary">@color/rx_accent</item>
        <item name="colorOnSecondary">@color/rx_on_primary</item>
        <item name="colorSecondaryContainer">@color/rx_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/rx_on_primary_container</item>
        <item name="colorTertiary">@color/rx_accent</item>
        <item name="colorSurface">?attr/rxSurface</item>
        <item name="colorOnSurface">@color/rx_text</item>
        <item name="colorSurfaceVariant">?attr/rxSurfaceAlt</item>
        <item name="colorOnSurfaceVariant">@color/rx_text2</item>
        <item name="colorSurfaceContainerLowest">?attr/rxBg</item>
        <item name="colorSurfaceContainerLow">?attr/rxSurface</item>
        <item name="colorSurfaceContainer">?attr/rxSurface</item>
        <item name="colorSurfaceContainerHigh">?attr/rxCard</item>
        <item name="colorSurfaceContainerHighest">?attr/rxSurfaceAlt</item>
        <item name="colorOutline">@color/rx_text2</item>
        <item name="colorOutlineVariant">?attr/rxOutline</item>
        <item name="colorError">@color/rx_error</item>
        <item name="colorErrorContainer">@color/rx_error_container</item>
        <item name="android:colorBackground">?attr/rxBg</item>
        <item name="colorOnBackground">@color/rx_text</item>
        <item name="android:windowBackground">?attr/rxBg</item>
        <item name="android:statusBarColor">?attr/rxBg</item>
        <item name="android:navigationBarColor">?attr/rxSurface</item>
        <item name="android:windowLightStatusBar">@bool/rx_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/rx_light_bars</item>
        <item name="android:forceDarkAllowed">false</item>

        <item name="materialButtonStyle">@style/Widget.Rainax.Button</item>
        <item name="chipStyle">@style/Widget.Rainax.Chip</item>
        <item name="bottomNavigationStyle">@style/Widget.Rainax.BottomNav</item>
        <item name="tabStyle">@style/Widget.Rainax.TabLayout</item>
        <item name="materialCardViewStyle">@style/Widget.Rainax.Card</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Rainax.BottomSheet</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Rainax.Dialog</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Rainax.Large</item>
    </style>

    <!-- AMOLED: pure black backgrounds (used together with dark mode) -->
    <style name="Theme.Rainax.Amoled" parent="Theme.Rainax">
        <item name="rxBg">@color/rx_amoled_bg</item>
        <item name="rxSurface">@color/rx_amoled_bg</item>
        <item name="rxCard">@color/rx_amoled_card</item>
        <item name="rxSurfaceAlt">@color/rx_amoled_alt</item>
        <item name="rxOutline">@color/rx_amoled_outline</item>
    </style>

    <!-- Full-screen black video player -->
    <style name="Theme.Rainax.Player" parent="Theme.Rainax">
        <item name="android:windowBackground">@color/rx_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="ThemeOverlay.Rainax.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Rainax.BottomSheet</item>
        <item name="android:navigationBarColor">?attr/rxSurface</item>
    </style>

    <style name="ThemeOverlay.Rainax.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Rainax.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Rainax.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Rainax.Button.Text</item>
        <item name="colorSurfaceContainerHigh">?attr/rxCard</item>
        <item name="android:textColorPrimary">@color/rx_text</item>
        <item name="android:textColorSecondary">@color/rx_text2</item>
    </style>

    <style name="Widget.Rainax.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">?attr/rxSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Rainax.Sheet</item>
    </style>

    <style name="ShapeAppearance.Rainax.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.Rainax.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Buttons: colours are set explicitly, never inherited from the system -->
    <style name="Widget.Rainax.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/rx_primary</item>
        <item name="android:textColor">@color/rx_on_primary</item>
        <item name="iconTint">@color/rx_on_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Rainax.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/rx_primary_container</item>
        <item name="android:textColor">@color/rx_on_primary_container</item>
        <item name="iconTint">@color/rx_on_primary_container</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Rainax.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/rxOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/rx_text</item>
        <item name="iconTint">@color/rx_text</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Rainax.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/rx_primary</item>
        <item name="iconTint">@color/rx_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Rainax.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/rx_text</item>
    </style>

    <!-- Chips -->
    <style name="Widget.Rainax.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?attr/rxSurfaceAlt</item>
        <item name="android:textColor">@color/rx_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">14dp</item>
    </style>

    <style name="Widget.Rainax.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/rx_chip_bg</item>
        <item name="android:textColor">@color/rx_chip_text</item>
        <item name="checkedIconTint">@color/rx_on_primary_container</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">14dp</item>
    </style>

    <!-- Cards -->
    <style name="Widget.Rainax.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/rxCard</item>
        <item name="strokeColor">?attr/rxOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Widget.Rainax.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/rxSurface</item>
        <item name="itemIconTint">@color/rx_nav_item</item>
        <item name="itemTextColor">@color/rx_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Rainax.NavIndicator</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Rainax.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/rx_primary_container</item>
    </style>

    <!-- Top pill tabs -->
    <style name="Widget.Rainax.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicator">@drawable/bg_tab_pill</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabSelectedTextColor">@color/rx_white</item>
        <item name="tabTextColor">@color/rx_text2</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabTextAppearance">@style/TextAppearance.Rainax.Tab</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.Rainax.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
