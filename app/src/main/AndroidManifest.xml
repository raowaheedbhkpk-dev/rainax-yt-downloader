        <!-- YouTube sign-in (Google's own page) -->
        <activity
            android:name=".SignInActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Welcome guide, shown once after the first install. -->
        <activity
            android:name=".WelcomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Private folder (PIN / pattern / password). Not open to other apps. -->
        <activity
            android:name=".PrivateActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Shorts: full-screen short videos, swipe up for the next -->
        <activity
            android:name=".ShortsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Rainax.Player" />

        <!-- Built-in player for finished downloads; also offered for any video/audio file ("Open with") -->
        <activity
            android:name=".PlayerActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|uiMode|density|navigation|keyboard"
            android:exported="true"
            android:label="RAINAX Player"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:taskAffinity="com.rainax.ytdownloader.player"
            android:theme="@style/Theme.Rainax.Player">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Background play: sound keeps playing with the screen off (media notification + lock screen controls) -->
        <service
            android:name=".BgPlayService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- auto-save WhatsApp statuses: Android runs this about every 30 minutes while it is on -->
        <service
            android:name=".StatusAutoJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- background play for downloaded videos (the full-screen player hands its list over here) -->
        <service
            android:name=".LocalPlayService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- switches the home-screen icon to the chosen accent a minute after you leave the app -->
        <service
            android:name=".IconJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
